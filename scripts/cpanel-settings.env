# Canlı sitenin GİZLİ OLMAYAN ayarları (depoda durur). Derlemede ortama alınır ve pakete settings.env olarak girer; app.js açılışta okur.
# Sırlar burada DEĞİL: scripts/cpanel-secrets.sh → secrets.env (yalnız sunucuda).
SITE_ENV=production
# Arama motorlarına açık (robots.txt + X-Robots-Tag). Kapatmak için false yapıp yeniden dağıtın.
SITE_INDEXABLE=true
# IndexNow anahtarı gizli değildir: /api/indexnow-key adresinde herkese açık yayımlanır (protokol gereği).
INDEXNOW_KEY=53c5112425cbad87e8584feb977fe176
# K-116 · Dosyalar hosting'de: herkese açık medya public_html/media (LiteSpeed doğrudan sunar), gizli belgeler web dışında.
MEDIA_DIR=/home/clkyapig/public_html/media
PRIVATE_DIR=/home/clkyapig/storage/private-documents
NEXT_PUBLIC_MEDIA_URL=https://clkyapigroup.com/media
