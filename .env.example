# ============================================
# CLK Yapı Group — Ortam Değişkenleri Şablonu
# Bu dosyayı .env.local olarak kopyalayıp doldurun.
# .env.local ASLA commit edilmez.
# ============================================

# --- Genel ---
NEXT_PUBLIC_SITE_URL=https://clkyapigroup.com
# Yayın (Faz 12) gününe kadar BOŞ kalır. 'true' + Vercel production olmadıkça site noindex'tir.
SITE_INDEXABLE=

# --- Supabase (herkese açık) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# --- Supabase (GİZLİ — yalnız sunucu) ---
# Dashboard → Project Settings → API Keys. Yeni tip sb_secret_ anahtarı bu projede henüz API'de kabul edilmiyor;
# Legacy sekmesindeki service_role anahtarı kullanılır (2026-09-18).
SUPABASE_SECRET_KEY=
DATABASE_URL=postgresql://postgres:PAROLA@db.xxxxxxxx.supabase.co:6543/postgres
DIRECT_URL=postgresql://postgres:PAROLA@db.xxxxxxxx.supabase.co:5432/postgres

# --- Mail ---
RESEND_API_KEY=re_xxx
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=bilgi@clkyapigroup.com
MAIL_TO_NOTIFICATIONS=bilgi@clkyapigroup.com

# --- Çeviri ---
ANTHROPIC_API_KEY=sk-ant-xxx

# --- Google ---
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# --- Hız sınırı ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- İndeksleme ---
INDEXNOW_KEY=

# --- İç güvenlik ---
CRON_SECRET=
REVALIDATE_SECRET=
